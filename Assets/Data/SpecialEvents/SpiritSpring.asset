  m_Name: SpiritSpring
  m_EditorClassIdentifier: 
  Title: SpiritSpring
  Prompt: You come across a small glade unmarked on your map, dense with wildflowers
    and illuminated by the beaming sunlight. In the center lies a beautiful pond,
    crisply transparent and framed by the natural beauty of the woods.
  Sprite: {fileID: 0}
  ChoicesToDisplay: 1
  Choices:
  - Text: Drink from the water.
    SuccessChance: 1
    _successText: 
    SuccessOutcomeData:
      Text: The water is as refreshing as it looks, and fills your adventurers with
        vigor. Filling a water flask, you find that the water quickly loses its allure
        the instant it leaves the pond.
      Outcomes:
      - Type: 14
        _moneyDelta: 0
        _equipment: {fileID: 0}
        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
    FailureOutcomeData:
      Text: 
      Outcomes: []
