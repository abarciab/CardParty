  m_Script: {fileID: 11500000, guid: 1d779d4715048234dbbf2415be188cb0, type: 3}
  m_Name: WishingWell
  m_EditorClassIdentifier: 
  Title: WishingWell
  Prompt: You see a wishing well upon a small hill. At the bottom of the well you
    can see the glint of silver. It's considered good luck to toss a coin into the
    well, giving deference the gods of travel and remembering those that never made
    it home
  Sprite: {fileID: 0}
  ChoicesToDisplay: 2
  Choices:
  - Text: Toss a coin into the well
    SuccessChance: 0.26
    _successText: get equipment
    SuccessOutcomeData:
      Text: You watch as your silver sinks into the water. Impossibly, you hear a
        distinct noise as your coin touches the bottom of the well. Suddenly, the
        well's bucket rises up to greet you. Inside lies a pristine piece of adventuring
        gear.
      Outcomes:
      - Type: 1
        MoneyDelta: 0
        _equipment: {fileID: 0}
        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
      - Type: 2
        MoneyDelta: 0
        _equipment: {fileID: 0}
        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
    FailureOutcomeData:
      Text: Your coin dissapears into the dark of the wellwater, now indistinguishable
        from the sheen of the others. You're unsure if your contribution was noted
        by anyone, mortal or otherwise.
      Outcomes: []
  - Text: Save your money.
    SuccessChance: 1
    _successText: 
    SuccessOutcomeData:
      Text: 
      Outcomes:
      - Type: 1
        MoneyDelta: 0
        _equipment: {fileID: 0}
        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
    FailureOutcomeData:
      Text: 
      Outcomes: []
