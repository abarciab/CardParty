        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
    FailureOutcomeData:
      Text: Good guess! It looks like the gods favor me today. I'll be taking my
        gold.
      Outcomes:
      - Type: 1
        MoneyDelta: -22
        _equipment: {fileID: 0}
        _newHire: {fileID: 0}
        _damageAmount: 0
        _numMapTiles: 0
  - Text: I don't trust this man.
    SuccessChance: 1
    _successText: 
    SuccessOutcomeData:
      Text: The man smiles wryly and looks back down. "I suppose you can't trust
        strangers these days, stranger. That wariness might keep you safe for now,
        but sometimes you need to take a risk to get ahead."
      Outcomes: []
